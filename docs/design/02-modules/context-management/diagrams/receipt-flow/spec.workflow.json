 "cards": [
  {
   "dot": "cyan",
   "title": "① 写入规则：什么时候落盘？",
   "items": [
    "advance / accept / append：receipt 变更随 Session member 一次 commit_incremental",
    "sidecar 物理双写已退役（仅保留旧文件迁移读）",
    "durable = Session 原子提交成功；失败返回明确错误按未确认处理"
   ]
  },
  {
   "dot": "amber",
   "title": "② 收口规则：指纹与 revision",
   "items": [
    "receipts 装配唯一化到 runtime 构造 ContextAppendData 之前",
    "revision 恒为提交后值（accepted 与 finalized 一致）",
    "fingerprint 8 位元组含 cleanup；旧指纹对账不受影响"
   ]
  },
  {
   "dot": "violet",
   "title": "③ 读取与恢复规则",
   "items": [
    "未 finalize：step_receipts 从实时账本派生",
    "已 finalize：只读冻结快照，后台迟到推进不改写",
    "旧 sidecar：一次性只读迁移（不存在才补、禁 Terminal 倒退）"
   ]
  }
 ]
