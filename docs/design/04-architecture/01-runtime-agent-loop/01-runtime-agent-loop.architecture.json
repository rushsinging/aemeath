  "cards": [
    {
      "dot": "cyan",
      "title": "唯一输入来源",
      "items": [
        "ChatRequest 只携带非可选 ingress",
        "SessionInputMailbox 是唯一 source reader",
        "首条与后续输入没有协议特例"
      ]
    },
    {
      "dot": "emerald",
      "title": "跨 Run 输入安全",
      "items": [
        "每个 RuntimeContext 绑定独立 RunInputBuffer",
        "DrainEpoch 线性化 drain 与 seal",
        "sealed Run 拒绝的 late input 回流到 Session deferred FIFO"
      ]
    },
    {
      "dot": "violet",
      "title": "Interaction 正交",
      "items": [
        "reply/cancel 不进入普通输入 mailbox",
        "单 Run 同时最多一个 PendingInteraction",
        "端口内多 waiter 只用于隔离并发 Run"
      ]
    }
  ]
