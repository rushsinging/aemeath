{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Aemeath Runtime Agent 与统一入站架构",
    "subtitle": "唯一 typed ingress 经 Session mailbox 接纳输入；每个 Run 拥有独立 input buffer，interaction reply/cancel 走正交定向通道",
    "output": "01-runtime-agent-loop.html",
    "quality_profile": "showcase",
    "visual_preset": "blueprint",
    "animation": "none",
    "viewBox": [
      1680,
      900
    ],
    "views": [
      {
        "id": "typed-input-path",
        "label": "Typed input 主链路",
        "focus": [
          "chatRequest",
          "inputSource",
          "sessionMailbox",
          "sessionActor",
          "runFactory",
          "runBuffer",
          "runLauncher",
          "loopEngine"
        ],
        "note": "首条输入、后续输入、Skill 与控制命令都从同一个 typed ingress 进入 Session mailbox。"
      },
      {
        "id": "late-input-path",
        "label": "Late input 回流",
        "focus": [
          "sessionMailbox",
          "sessionActor",
          "runBuffer"
        ],
        "note": "sealed Run 拒绝的用户输入回到 Session deferred FIFO，并在下一 Run 中优先消费。"
      },
      {
        "id": "interaction-path",
        "label": "Interaction 定向恢复",
        "focus": [
          "interactionClient",
          "sessionIngress",
          "interactionPort",
          "loopEngine"
        ],
        "note": "reply/cancel 只按 request identity 恢复唯一 pending interaction，不伪装成普通输入。"
      },
      {
        "id": "shared-execution",
        "label": "统一执行内核",
        "focus": [
          "runFactory",
          "runBuffer",
          "runLauncher",
          "loopEngine",
          "stepPipeline"
        ],
        "note": "输入来源不同不产生第二套 Loop；RunLauncher 与 Loop Engine 保持唯一。"
      }
    ]
  },
