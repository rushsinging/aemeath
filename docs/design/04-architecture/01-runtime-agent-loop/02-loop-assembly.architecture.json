  "cards": [
    {
      "dot": "cyan",
      "title": "创建与输入解耦",
      "items": [
        "RunCreationRequest 不携带用户输入",
        "RunFactory 创建完整 RunInstance",
        "输入只在 Run 创建后进入绑定的 RunInputBuffer"
      ]
    },
    {
      "dot": "emerald",
      "title": "两级输入所有权",
      "items": [
        "SessionInputMailbox 独占外部 source 与 deferred FIFO",
        "RunInputBuffer 独占当前 Run 的 epoch 与 seal",
        "late input 从 sealed Run 安全回流到下一 Run"
      ]
    },
    {
      "dot": "violet",
      "title": "Interaction 单槽",
      "items": [
        "每次 register 产生一个 one-shot receiver",
        "Run 使用 Option 拒绝第二个 active interaction",
        "端口的多 request map 只隔离并发 Run"
      ]
    }
