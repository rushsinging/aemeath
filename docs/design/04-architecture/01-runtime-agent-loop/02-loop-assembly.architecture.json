        "label": "输入所有权",
        "focus": [
          "sessionMailbox",
          "runBuffer",
          "runInstance",
          "launcher"
        ],
        "note": "Session mailbox 拥有 source/deferred，Run buffer 拥有 drain epoch/seal，二者不共享状态。"
      },
      {
        "id": "interaction-ownership",
        "label": "Interaction 所有权",
        "focus": [
          "interactionBinding",
          "pendingInteraction",
          "runInstance",
          "launcher"
        ],
        "note": "Factory 绑定 InteractionPort；Run 只持有一个 pending interaction continuation。"
      }
    ]
