#!/usr/bin/env bash
# Git pre-commit：只运行本地、轻量、与 staged 路径相关的检查。
set -euo pipefail

top=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$top"

# 隔离 git 注入的仓库本地环境变量：worktree 场景下 git 会注入
# GIT_DIR=<主仓>/.git/worktrees/<worktree>；一旦泄漏给本 hook 的子进程
# （guard 脚本 → cargo test → 测试 fixture 的 git init），git 会把主仓 config
# 判成 bare 仓库并写入 core.bare=true，导致主仓不可用。
while IFS= read -r git_local_var; do unset "$git_local_var"; done < <(git rev-parse --local-env-vars 2>/dev/null || true)
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[[ -n "$staged" ]] || exit 0

if printf '%s\n' "$staged" | grep -qE '\.rs$'; then
    cargo fmt
    git add -u -- '*.rs'
fi

if printf '%s\n' "$staged" | grep -qE '^(agent|apps|packages|tools/xtask|\.agents)/'; then
    cargo run --quiet -p xtask -- source-guard "$top"
fi

if printf '%s\n' "$staged" | grep -qE '(^|/)(scenario_tests|snapshots)(/|\.)|\.snap$'; then
    drafts=$(find apps/cli -type f \( -name '*.snap.new' -o -name '.pending-snap' \) -print)
    if [[ -n "$drafts" ]]; then
        printf 'error: pending insta snapshot files:\n%s\n' "$drafts" >&2
        exit 1
    fi
fi
